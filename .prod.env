# Server
NODE_ENV=production
PORT=PORT_Production
HOST=Host_Production
APP_URL=APP_URL_Production
APP_FRONTEND_URL=Frontend_URL_Production

# MongoDB
DB_HOST=
DB_PORT=27017
DB_NAME=DBIntersight
DB_USER=
DB_PASSWORD=

#JWT
SECRET_KEY=authintersight
JWT_EXPIRES_IN=7d

# Emotion Detection API
BASE_URL_API=BASE_URL_API_DETECTION
EMOTION_API_KEY=API_KEY_EMOTION_DETECTION

# Google OAuth
# Dapatkan dari: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID

# Facebook OAuth
# Dapatkan dari: https://developers.facebook.com/ → My Apps → Settings → Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple OAuth (Sign In with Apple)
# Dapatkan dari: https://developer.apple.com/ → Certificates, IDs & Profiles → Services IDs
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
